# OpenAI-совместимый API (на платформе ПСБ переменные подставляет окружение)
LLM_BASE_URL=
LLM_API_KEY=
# Модель генерации, например DeepSeek V4.1 Flash
LLM_MODEL=

# Эмбеддинги и реранкер (тот же прокси, что и LLM)
EMB_MODEL=baai/bge-m3
RERANKER_MODEL=
# Имя переменной реранкера в модульном конвейере
RERANK_MODE=auto
RERANK_MODEL=

# Данные: каталог с knowledge-base.zip (и questions.csv для пакетного запуска)
DATA_DIR=data
ARTIFACTS_DIR=artifacts

# Модульный конвейер (корневой solution.py)
EMB_BASE_URL=
EMB_API_KEY=
QUERY_PROCESSING_MODE=single
MAX_WORKERS=2
ANSWER_VERIFY_MAX_RETRIES=2
