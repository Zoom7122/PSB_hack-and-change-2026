# Параметры OpenAI-совместимого API; на платформе задаются окружением.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMB_MODEL=baai/bge-m3
RERANKER_MODEL=

# Входные файлы для запуска вне Docker.
DATA_DIR=data
# Параметры пакетного запуска.
SOLUTION_WORKERS=4
SOLUTION_TIME_BUDGET=1080
ANSWER_VERIFY_MAX_RETRIES=2

# Порты Compose (dev API и Dozzle по умолчанию доступны только локально).
FRONTEND_PORT=8000
BACKEND_PORT=8001
DOZZLE_PORT=9999
