# Подключение к LLM — те же имена, что в модуле 2 (Query Processing).
# На платформе хакатона: DeepSeek V4.1 Flash через API организаторов.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1500
LLM_TIMEOUT=60
# true — передавать response_format=json_object (при отказе провайдера отключается сам)
LLM_JSON_MODE=false

# Генерация и проверка
ANSWER_MAX_WORDS=150
ANSWER_MAX_CONTEXT_CHUNKS=8
ANSWER_MAX_CHUNK_CHARS=3000
# llm — правила + LLM-проверка утверждений (2 вызова); rules — только правила (1 вызов)
ANSWER_VERIFICATION_MODE=llm
ANSWER_MAX_REPAIRS=1
ANSWER_LLM_RETRIES=1
# Отказ без LLM, если у всех чанков есть scores и они ниже порогов (пороги из модулей 3–4)
ANSWER_EVIDENCE_GATE=true
ANSWER_GATE_BM25_MIN=4.0
ANSWER_GATE_VECTOR_MIN=0.30
ANSWER_INFER_EVENT_DATE=true

HOST=0.0.0.0
PORT=8005
